{
  "manifest_version": 3,
  "name": "Alquimia",
  "version": "1.5",
  "description": "Muda qualquer página com um pedido em linguagem natural.",
  "browser_specific_settings": {
    "gecko": {
      "id": "alquimia@local",
      "strict_min_version": "153.0",
      "data_collection_permissions": { "required": ["websiteContent", "browsingActivity"] }
    }
  },
  "permissions": ["storage", "scripting", "menus"],
  "optional_permissions": ["userScripts"],
  "host_permissions": ["<all_urls>"],
  "background": { "scripts": ["defaults.js", "icon.js", "background.js"] },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["loader.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Alquimia",
    "default_icon": "icons/toolbar-dark.svg",
    "theme_icons": [
      { "light": "icons/toolbar-light.svg", "dark": "icons/toolbar-dark.svg", "size": 16 },
      { "light": "icons/toolbar-light.svg", "dark": "icons/toolbar-dark.svg", "size": 32 }
    ]
  },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "icons": { "48": "icons/alquimia.svg", "96": "icons/alquimia.svg" }
}
